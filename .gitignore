!features/nav.js
!features/*/index.html
!features/*/*.webp
!solutions/
!solutions/index.html
!solutions/*.webp
!hero-phone.webp
!sol-favicon.svg
!g-calculator.svg
!g-insight.svg
!g-stat-62.svg
!g-stat-85.svg
!g-cost.svg
!fonts/
!fonts/*.ttf
!SolReception-Logo-Pack 2/
